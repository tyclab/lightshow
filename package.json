{
  "name": "tycstation-lightshow",
  "version": "3.0.0",
  "description": "TycStation Lightshow: lighting control for Art-Net, sACN, WLED, OpenRGB and Hue Entertainment",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyclab/lightshow.git"
  },
  "bugs": "https://github.com/tyclab/lightshow/issues",
  "homepage": "https://github.com/tyclab/lightshow#readme",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.js",
    "watch:client": "node scripts/build-client.js --watch",
    "prestart": "npm run build:client",
    "start": "node server.js",
    "dev": "node --watch server.js --no-supervisor",
    "preflight": "node scripts/preflight.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "test:performance": "node --test --test-concurrency=1 tests/performance/*.bench.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:performance",
    "test:e2e": "npm run build:client && playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "easymidi": "^3.2.0",
    "express": "^5.2.1",
    "node-dtls-client": "^2.0.3",
    "pino": "^10.3.1",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdi/js": "7.4.47",
    "@playwright/test": "1.65.1",
    "@preact/signals": "2.11.4",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "nosleep.js": "0.12.0",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.3",
    "three": "0.187.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
